# DWEA — local environment template
#
# Copy to `.env.local` (NOT committed) and fill in keys.
# Vite exposes only `VITE_*` variables to the browser bundle.

# --- STT (push-to-talk transcription) -----------------------------------------
#
# When VITE_GROQ_API_KEY is set, the mic uses Groq Whisper-large-v3-turbo
# (free tier; multilingual incl. German). Without it we fall back to the
# browser's Web Speech API. See ADR 0010.
VITE_GROQ_API_KEY=

# Force a specific provider regardless of the key. One of:
#   groq        — Whisper via Groq (requires VITE_GROQ_API_KEY)
#   web-speech  — browser SpeechRecognition (Chrome/Safari)
# Leave blank for auto: Groq when the key is present, else web-speech.
VITE_STT_PROVIDER=

# BCP-47 language hint for Whisper. Omit for auto-detect.
# Examples: de, en, fr.
VITE_STT_LANGUAGE=

# --- Chat LLM (OpenRouter) ----------------------------------------------------
#
# The chat API key itself is entered through the in-app settings dialog
# (kept in localStorage; never baked into the bundle). Only the model id is
# build-time configurable.
#
# Defaults to `openai/gpt-oss-120b:free`. Other free-tier candidates that
# support OpenAI tool-calls reliably enough for the 5-tool motor:
#   meta-llama/llama-3.3-70b-instruct:free
#   deepseek/deepseek-chat-v3:free
#   qwen/qwen-2.5-72b-instruct:free
#
# If you find the free tier flaky for tool calls, drop in a paid-but-cheap
# override here (e.g. `meta-llama/llama-3.3-70b-instruct`) and document the
# per-turn cost in your commit / ADR.
VITE_OPENROUTER_MODEL=
